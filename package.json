    "preact": "10.29.8"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.5.2",
    "@preact/preset-vite": "2.10.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
