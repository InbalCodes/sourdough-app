{
  "appId": "com.inbal.levain",
  "appName": "Levain",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "preferredContentMode": "mobile",
    "includePlugins": ["@capacitor-firebase/crashlytics", "@capawesome/capacitor-app-review", "@capacitor/app", "@capacitor/local-notifications", "@capacitor/status-bar", "@revenuecat/purchases-capacitor"]
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    }
  }
}
